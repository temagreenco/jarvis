# RunPod Optimized Settings
# Copy to .env or source before running

# GPU Settings - Use all available GPU power
JARVIS_USE_GPU=true
JARVIS_GPU_DEVICE=0

# Whisper - Large model for accuracy, float16 for speed
JARVIS_WHISPER_MODEL=large-v3
JARVIS_WHISPER_DEVICE=cuda
JARVIS_WHISPER_COMPUTE_TYPE=float16

# FFmpeg - GPU encoding with quality
JARVIS_VIDEO_CODEC=h264_nvenc
JARVIS_FFMPEG_PRESET=p4
JARVIS_FFMPEG_CRF=18

# Faster processing - reduce quality checks for speed
JARVIS_TARGET_REELS=8
JARVIS_MIN_REEL_DURATION=15.0
JARVIS_MAX_REEL_DURATION=40.0

# Output
JARVIS_OUTPUT_WIDTH=1080
JARVIS_OUTPUT_HEIGHT=1920
JARVIS_FPS=30
