# JARVIS Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI Provider API Keys (at least one required for Crispy)
# =============================================================================

# OpenAI (GPT-4o) - Best for Hebrew
JARVIS_OPENAI_API_KEY=sk-your-openai-key-here
JARVIS_OPENAI_MODEL=gpt-4o

# Google Gemini - Good Hebrew, cheaper
JARVIS_GEMINI_API_KEY=your-gemini-key-here
JARVIS_GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude - Strong reasoning
JARVIS_CLAUDE_API_KEY=sk-ant-your-claude-key-here
JARVIS_CLAUDE_MODEL=claude-sonnet-4-20250514

# Default provider (openai, gemini, claude, ollama)
JARVIS_DEFAULT_AI_PROVIDER=openai

# =============================================================================
# Local LLM (Ollama) - Free fallback
# =============================================================================
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_MODEL=llama3.1:8b

# =============================================================================
# Video Processing (for video editor module)
# =============================================================================
JARVIS_USE_GPU=true
JARVIS_GPU_DEVICE=0
JARVIS_WHISPER_MODEL=large-v3

# =============================================================================
# Telegram Bot (optional)
# =============================================================================
# JARVIS_TELEGRAM_TOKEN=your-bot-token
# JARVIS_TELEGRAM_ALLOWED_USERS=[123456789]
