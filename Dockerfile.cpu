# JARVIS / Crispy - CPU-only version (no GPU required)
# Lighter image for API-only usage

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy requirements first (for caching)
COPY requirements.txt .

# Install Python dependencies (skip GPU packages)
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        python-dotenv pydantic pydantic-settings rich typer \
        openai anthropic google-generativeai httpx \
        aiohttp aiofiles loguru tenacity \
        fastapi uvicorn[standard]

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/data

# Expose port for web API
EXPOSE 8000

ENV JARVIS_USE_GPU=false
ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command
CMD ["python", "-m", "uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000"]
